# Copie para src/.env e preencha com os seus valores.
# NUNCA coloque credenciais reais neste arquivo: ele e versionado.
NAME_DB="<nome_do_banco>"
USER_DB="<usuario_do_banco>"
PASSWORD_DB="<senha_do_banco>"
HOST_DB="127.0.0.1"
PORT_DB="3306"

EMAIL_SMTP="smtp.exemplo.com"
EMAIL_PORT="587"
EMAIL_USER="<usuario@exemplo.com>"
EMAIL_PASSWORD="<senha_de_app>"
EMAIL_IMAP="imap.exemplo.com"


LOGIN_MT5="<login_mt5>"
PASSWORD_MT5="<senha_mt5>"
SERVER_MT5="<servidor_da_corretora>"
BINANCE_API_KEY="<chave_api_binance>"
BINANCE_API_SECRET_KEY="<segredo_api_binance>"


# Configurações do Modelo
USE_GPU= True  # Use True para treinar na GPU, False para CPU.
SEED= 22
